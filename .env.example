# Docker: directory containing your ROCm-compatible llama-server binary.
LLAMA_ROCM_DIR=/path/to/llama-rocm
MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.6-27B-IQ4_XS.gguf

# Compose service addresses. For host Python, use localhost and port 8081.
BACKEND_URL=http://llm:8080
TAILSCALE_HOST=127.0.0.1
MODEL_NAME=llm
REQUEST_TIMEOUT=300

# stub uses local fixtures; mqtt uses physical nodes or the simulator.
IOT_PROVIDER=stub
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
# Optional comma-separated room/node paths; leave blank for discovery.
MQTT_NODES=
CAMERA_FRAME_FIXTURE_PATH=/app/test_image_room.png

# External tracing is opt-in. Configure keys locally if you enable it.
LANGFUSE_ENABLED=false
LANGFUSE_ENVIRONMENT=local
LANGFUSE_TRACE_NAME=mrp-agent-run
LANGFUSE_FLUSH_ON_RUN_END=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# Optional external evaluation judge.
DEEPSEEK_API_KEY=
